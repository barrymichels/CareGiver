<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Admin - Schedule Management</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <%- include('partials/header', { user }) %>
    
    <main class="admin-content">
        <div class="schedule-manager">
            <div class="admin-controls">
                <div class="nav-buttons-spacer"></div>
                <h2 class="admin-title"><%= weekTitle %></h2>
                <div class="nav-buttons">
                    <% if (weekOffset > -4) { %><a href="/admin?weekOffset=<%= weekOffset - 1 %>" class="nav-button prev-week">&larr; Previous</a><% } %>
                    <% if (weekOffset < 8) { %><a href="/admin?weekOffset=<%= weekOffset + 1 %>" class="nav-button next-week">Next &rarr;</a><% } %>
                </div>
            </div>

            <div class="schedule-template-bar">
                <div class="schedule-template-info">
                    <span class="schedule-template-label">Schedule template</span>
                    <strong><%= weekData.config?.template_name || (weekData.config ? 'Custom schedule' : 'Default Schedule') %></strong>
                </div>
                <div class="template-week-actions">
                    <% if (canModifyWeek) { %><button type="button" id="changeWeekTemplate" class="nav-button">Change template</button><% } else { %><span>Past weeks are locked</span><% } %>
                    <a href="/admin/timeslots" class="nav-button">Manage templates</a>
                </div>
            </div>
            <div class="schedule-grid">
                <% weekDates.forEach((day, dayIndex) => { %>
                    <div class="schedule-day">
                        <div class="day-header">
                            <div class="day-name"><%= day.name %></div>
                            <div class="day-date"><%= day.formatted %></div>
                        </div>
                        <div class="time-slots">
                            <% (weekData.timeslots[dayIndex] || []).forEach(slot => { %>
                                <% 
                                const assignment = assignments.find(a => 
                                    a.day_date === day.date &&
                                    a.time_slot === slot.time
                                );
                                
                                const availableUsers = availability
                                    .filter(a => 
                                        a.day_date === day.date &&
                                        a.time_slot === slot.time
                                    )
                                    .map(a => ({
                                        id: a.user_id,
                                        firstName: a.first_name,
                                        lastName: a.last_name
                                    }));

                                // Check if assigned user is no longer available
                                const hasConflict = assignment && !availableUsers.some(u => u.id === assignment.user_id);
                                %>
                                <div class="schedule-slot <%= hasConflict ? 'has-conflict' : '' %>">
                                    <div class="slot-header">
                                        <span class="slot-time"><%= slot.time %></span>
                                        <span class="available-count">
                                            <%= availableUsers.length %> Available
                                            <% if (hasConflict) { %>
                                                <span class="conflict-indicator">Conflict</span>
                                            <% } %>
                                        </span>
                                    </div>
                                    <div class="slot-content">
                                        <div class="user-options">
                                            <label class="user-option">
                                                <input type="radio" 
                                                       name="slot-<%= day.date %>-<%= slot.time %>"
                                                       value=""
                                                       data-date="<%= day.date %>"
                                                       data-time="<%= slot.time %>"
                                                       <%= !assignment ? 'checked' : '' %>>
                                                <span class="option-label">Unassigned</span>
                                            </label>
                                            <% if (hasConflict) { %>
                                                <label class="user-option conflict">
                                                    <input type="radio" 
                                                           name="slot-<%= day.date %>-<%= slot.time %>"
                                                           value="<%= assignment.user_id %>"
                                                           data-date="<%= day.date %>"
                                                           data-time="<%= slot.time %>"
                                                           checked>
                                                    <span class="option-label"><%= assignment.first_name %></span>
                                                </label>
                                            <% } %>
                                            <% availableUsers.forEach(user => { %>
                                                <label class="user-option">
                                                    <input type="radio" 
                                                           name="slot-<%= day.date %>-<%= slot.time %>"
                                                           value="<%= user.id %>"
                                                           data-date="<%= day.date %>"
                                                           data-time="<%= slot.time %>"
                                                           <%= !hasConflict && assignment && assignment.user_id === user.id ? 'checked' : '' %>>
                                                    <span class="option-label"><%= user.firstName %></span>
                                                </label>
                                            <% }) %>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% }) %>
            </div>

            <div class="user-filter">
                <h3 class="section-subtitle">Filter Schedule</h3>
                <div class="user-list">
                    <button class="user-filter-btn" data-filter="unassigned">
                        <span class="user-name">Show Unassigned</span>
                    </button>
                    <% 
                    const uniqueUsers = [...new Set([
                        ...assignments.map(a => a.user_id),
                        ...availability.map(a => a.user_id)
                    ])].map(id => {
                        const user = users.find(u => u.id === id);
                        const count = assignments.filter(a => a.user_id === id).length;
                        return { id, firstName: user.first_name, count };
                    });
                    %>
                    <% uniqueUsers.forEach(user => { %>
                        <button class="user-filter-btn" data-user-id="<%= user.id %>">
                            <span class="user-name"><%= user.firstName %></span>
                            <span class="slot-count"><%= user.count %></span>
                        </button>
                    <% }) %>
                </div>
            </div>

            <div class="schedule-actions">
                <button type="button" id="saveSchedule" class="action-button">Save Schedule</button>
            </div>
        </div>
    </main>

    <% if (canModifyWeek) { %>
    <dialog id="weekTemplateDialog" class="week-template-dialog" aria-labelledby="weekTemplateTitle">
        <form id="weekTemplateForm" data-week-start="<%= weekStartKey %>">
            <h2 id="weekTemplateTitle">Change template for <%= weekTitle.toLowerCase() %></h2>
            <p>Week beginning <%= weekStartKey %>. This replaces this week's times only. Other weeks and templates stay unchanged.</p>
            <label for="weekTemplateSelect">Template</label>
            <select id="weekTemplateSelect" name="template">
                <option value="default">Use current default<% const defaultTemplate = templates.find(t => t.is_default); %><%= defaultTemplate ? ` (${defaultTemplate.name})` : '' %></option>
                <% templates.forEach(template => { %><option value="<%= template.id %>" <%= weekData.config?.template_id === template.id && !weekData.config?.uses_default ? 'selected' : '' %>><%= template.name %></option><% }) %>
            </select>
            <div id="weekTemplateConflicts" role="alert" hidden></div>
            <p id="weekTemplateError" role="alert"></p>
            <div class="template-week-actions"><button type="button" id="cancelWeekTemplate">Cancel</button><button type="submit" id="applyWeekTemplate">Apply to this week</button></div>
        </form>
    </dialog>
    <% } %>
    <%- include('partials/unsaved-changes-modal') %>
    <script src="/js/header.js"></script>
    <script src="/js/schedule-manager.js"></script>
</body>
</html>
