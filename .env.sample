ENABLE_AUTHENTIK_LOGIN=true
AUTHENTIK_AUTH_URL=your_auth_url_here
AUTHENTIK_TOKEN_URL=your_token_url_here
AUTHENTIK_CLIENT_ID=your_client_id_here
AUTHENTIK_CLIENT_SECRET=your_client_secret_here
AUTHENTIK_CALLBACK_URL=your_callback_url_here

PORT=3000
SESSION_SECRET=your_session_secret_here
DB_PATH=./data/database.sqlite

# Absolute address of this installation: scheme, host and port, no trailing slash.
# Required, not cosmetic - the password-reset e-mail and the virtual-user
# conversion link are built as `${BASE_URL}/reset-password/<token>`, so with this
# unset they read "undefined/reset-password/..." and nobody can reset a password.
BASE_URL=https://schedule.example.com

# Process timezone for notification timing. docker-compose.yml already sets this.
# Schedule dates always follow America/New_York, even when this process uses UTC.
TZ=America/New_York

# Optional override for the login/password-reset rate limiters: "on" or "off".
# Unset means enabled everywhere except the Jest suite.
# RATE_LIMITS=on

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# Sender shown on password-reset mail. Falls back to SMTP_USER if unset.
SMTP_FROM=noreply@example.com
SMTP_SECURE=true

APP_TITLE=CareGiver
ICS_EVENT_SUMMARY=CareGiver Shift

# Push notification settings - Generate with: node scripts/generate-vapid.js
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:admin@example.com

# Notification debug logging (set to 'true' for verbose logging)
NOTIFICATION_DEBUG=false
