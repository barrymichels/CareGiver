<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= getPageTitle('Schedule Templates') %></title>
<link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/header.css"><link rel="stylesheet" href="/css/templates.css">
</head><body>
<%- include('../partials/header', { user }) %>
<main class="template-manager">
<div class="row spread"><h1>Schedule Templates</h1><button type="button" class="primary" data-action="new">+ Create template</button></div>
<p id="template-status" role="status" aria-live="polite"></p>
<div id="template-workspace"></div>
<noscript>Enable JavaScript to manage schedule templates.</noscript>
</main>
<dialog id="template-dialog" class="template-dialog" aria-labelledby="dialog-title"></dialog>
<script id="template-data" type="application/json"><%- escapeJsonForEmbed(templateData) %></script>
<script src="/js/header.js"></script><script src="/js/template-manager.js"></script>
</body></html>
